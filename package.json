{
  "name": "albert",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run tests/unit --passWithNoTests",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "e2e": "playwright test",
    "smoke": "tsx scripts/smoke.ts",
    "eval:hints": "tsx scripts/eval-hints.ts",
    "agent:ingest": "tsx scripts/agent-ingest.ts",
    "agent:replan": "node -e \"console.log('not built yet (Phase 6)')\" --",
    "ingest:flat": "tsx scripts/ingest-flat.ts",
    "seed:pdf": "tsx scripts/seed-pdf.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "check:tracks": "node -e \"console.log('not built yet (Phase 8)')\" --"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.6.5",
    "@langchain/aws": "^1.5.2",
    "@langchain/core": "^1.4.1",
    "@langchain/langgraph": "^1.7.4",
    "@langchain/langgraph-checkpoint-mongodb": "^1.5.1",
    "@langchain/xai": "^1.5.6",
    "@mathjax/src": "4.1.3",
    "@napi-rs/canvas": "^1.1.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "deepagents": "^1.16.5",
    "langchain": "^1.6.6",
    "mongodb": "^7.9.0",
    "nanoid": "^6.0.2",
    "next": "16.4.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "perfect-freehand": "^1.2.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "roughjs": "^4.6.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "marked": "^18.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
